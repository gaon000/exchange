import "C"

import (
	"encoding/json"
	"errors"
	"fmt"
	"os"
	"path/filepath"
	"sync"
	"syscall"
	"time"
)

// Sync requires F_FULLFSYNC and never falls back to a weaker operation.
func Sync(file *os.File) error {
	raw, err := file.SyscallConn()
	if err != nil {
		return err
	}
	var syncErr error
	var cdata C.struct_exchange_sync_record
	observed := time.Now().UTC()
	err = raw.Control(func(fd uintptr) {
		if code := C.exchange_full_sync(C.int(fd), &cdata); code != 0 {
			syncErr = syscall.Errno(code)
		}
	})
	if os.Getenv("EXCHANGE_TRACE") == "1" {
		syncRecords.Lock()
		if len(syncRecords.rows) >= 200000 {
			syncRecords.Unlock()
			return errors.Join(err, syncErr, fmt.Errorf("sync record limit"))
		}
		syncRecords.rows = append(syncRecords.rows, ioRecord{observed, filepath.Base(file.Name()), int64(cdata.start), int64(cdata.end), int64(cdata.cpu_start), int64(cdata.cpu_end), int(cdata.attempts), cdata.clock_ok != 0, fmt.Sprint(errors.Join(err, syncErr))})
		syncRecords.Unlock()
	}
	return errors.Join(err, syncErr)
}

// Lock takes an exclusive nonblocking advisory lock until the file is closed.
func Lock(file *os.File) error {
	raw, err := file.SyscallConn()
	if err != nil {
		return err
	}
	var lockErr error
	err = raw.Control(func(fd uintptr) {
		for {
			lockErr = syscall.Flock(int(fd), syscall.LOCK_EX|syscall.LOCK_NB)
			if !errors.Is(lockErr, syscall.EINTR) {
				break
			}
		}
	})
	return errors.Join(err, lockErr)
}

// Contended identifies a lock already held by another open file description.
func Contended(err error) bool { return errors.Is(err, syscall.EWOULDBLOCK) }

// CheckFilesystem rejects filesystems outside the verified v1 APFS scope.
func CheckFilesystem(path string) error {
	var info syscall.Statfs_t
	if err := syscall.Statfs(path, &info); err != nil {
		return err
	}
	var name []byte
	for _, c := range info.Fstypename {
		if c == 0 {
			break
		}
		name = append(name, byte(c))
	}
	if string(name) != "apfs" {
		return fmt.Errorf("unsupported filesystem: %s", name)
	}
	return nil
}

type ioRecord struct {
	ObservedUTC                  time.Time
	File                         string
	Start, End, CPUStart, CPUEnd int64
	Attempts                     int
	ClockAvailable               bool
	Error                        string
}

var syncRecords struct {
	sync.Mutex
	rows []ioRecord
}

// WriteIORecords writes task-local observations after both storage workers drain.
func WriteIORecords(path string) error {
	syncRecords.Lock()
	defer syncRecords.Unlock()
	f, e := os.OpenFile(path, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
	if e != nil {
		return e
	}
	enc := json.NewEncoder(f)
	for _, r := range syncRecords.rows {
		if e = enc.Encode(r); e != nil {
			f.Close()
			return e
		}
	}
	return errors.Join(f.Sync(), f.Close())
}
